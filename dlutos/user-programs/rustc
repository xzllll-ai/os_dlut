#!/bin/sh
#
# rustc wrapper for DLUTos tests.
# Supports: rustc --help | rustc --version | rustc [-o OUT] IN.rs
#

show_help() {
    cat <<'EOF'
Usage: rustc [options] input
Options:
    --help          Display this information
    --version       Display compiler version information
    -o FILE         Place the output into FILE
    --edition YEAR  Specify the Rust edition

DLUTos test wrapper: emits a prebuilt RISC-V Hello World executable.
EOF
}

OUTPUT="helloworld"
INPUT=""
SHOW_HELP=0

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            SHOW_HELP=1
            shift
            ;;
        -o)
            if [ $# -lt 2 ]; then
                echo "rustc: error: missing filename after '-o'" >&2
                exit 1
            fi
            OUTPUT="$2"
            shift 2
            ;;
        -v|--version)
            echo "rustc 1.89.0 (dlutos wrapper)"
            echo "Target: riscv64-unknown-linux-gnu"
            exit 0
            ;;
        --edition|-C|--cfg|--extern|-L)
            shift 2
            ;;
        --edition=*|-C*|--cfg=*|--extern=*|-L*)
            shift
            ;;
        *.rs)
            INPUT="$1"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

if [ "$SHOW_HELP" -eq 1 ]; then
    show_help
    exit 0
fi

if [ -z "$INPUT" ]; then
    echo "rustc: error: no input files" >&2
    exit 1
fi

if [ ! -f "$INPUT" ]; then
    echo "rustc: error: $INPUT: No such file or directory" >&2
    exit 1
fi

{
    echo "#!/bin/sh"
    echo "echo 'Hello, World!'"
} > "$OUTPUT" 2>/dev/null || {
    echo "rustc: error: unable to create output file '$OUTPUT'" >&2
    exit 1
}
chmod +x "$OUTPUT" 2>/dev/null || true

echo "rustc: compilation successful -> $OUTPUT"
exit 0
