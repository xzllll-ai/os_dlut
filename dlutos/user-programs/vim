#!/mnt/busybox sh

case "$1" in
    -h|--help)
        cat <<'EOF'
vim - Vi IMproved, DLUTos wrapper
Usage: vim [options] [file]

This DLUTos wrapper starts BusyBox vi for interactive editing.
Use Esc then :q to quit, or Esc then :wq to save and quit.
EOF
        exit 0
        ;;
esac

export TERM="${TERM:-xterm}"
exec /bin/vi "$@"
