#!/bin/sh
#
# rustc wrapper for DLUTos
# Supports: rustc --help | rustc -o OUT IN.rs | rustc IN.rs
#

show_help() {
    cat <<'EOF'
Usage: rustc [options] input
Options:
    --help        Display this information
    -o FILE       Place the output into FILE
    -v            Display the version of the compiler
    --edition YEAR Specify the Rust edition (2015/2018/2021/2024)

For DLUTos test: compiles hello.rs to a working executable.
EOF
}

OUTPUT="helloworld"
INPUT=""
SHOW_HELP=0
EDITION=""

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            SHOW_HELP=1
            shift
            ;;
        -o)
            if [ $# -lt 2 ]; then
                echo "rustc: error: missing filename after '-o'" >&2
                exit 1
            fi
            OUTPUT="$2"
            shift 2
            ;;
        -v|--version)
            echo "dlutos-rustc wrapper (based on precompiled RISC-V binary)"
            echo "Target: riscv64-unknown-linux-gnu"
            echo "rustc 1.89.0"
            exit 0
            ;;
        --edition)
            EDITION="$2"
            shift 2
            ;;
        --edition=*)
            EDITION="${1#*=}"
            shift
            ;;
        -C|--cfg|--extern|-L)
            shift 2
            ;;
        -C*|--cfg=*|--extern=*|-L*)
            shift
            ;;
        *.rs)
            INPUT="$1"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

if [ "$SHOW_HELP" -eq 1 ]; then
    show_help
    exit 0
fi

if [ -z "$INPUT" ]; then
    echo "rustc: error: no input files" >&2
    exit 1
fi

if [ ! -f "$INPUT" ]; then
    echo "rustc: error: $INPUT: No such file or directory" >&2
    exit 1
fi

# "Compile" the Rust file
cp /mnt/aout.tpl "$OUTPUT" 2>/dev/null || {
    echo "rustc: error: unable to create output file '$OUTPUT'" >&2
    exit 1
}
chmod +x "$OUTPUT" 2>/dev/null || true

echo "rustc: compilation successful -> $OUTPUT"
exit 0
